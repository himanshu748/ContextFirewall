# Frontend configuration. Copy to .env.local for local dev.
# In production (Vercel), set NEXT_PUBLIC_API_URL to the deployed Hugging Face Space URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Supabase auth for the console (frontend/lib/supabase.ts).
# If either is unset, the console runs in read-only demo mode and the auth UI is hidden.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable / anon key>
